# Kairo Environment Configuration
# ---------------------------------
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Run 'python src/setup.py' to configure interactively.
# See docs/configuration.md for detailed documentation.


# ── Discord ────────────────────────────────────────────────────────
# Required. Get these from https://discord.com/developers/applications

# Your bot's secret token. NEVER share this.
BOT_TOKEN=

# Your application's Client ID (found on the application General Information page).
CLIENT_ID=

# Your application's Client Secret (used for OAuth2 dashboard login).
CLIENT_SECRET=

# Legacy text command prefix. Defaults to "!".
# Most commands are slash commands; this is only for legacy text commands.
BOT_PREFIX=!


# ── Development ────────────────────────────────────────────────────
# Guild ID for instant slash command sync during development.
# Leave empty in production (global sync, takes up to 1 hour).
DEV_GUILD_ID=


# ── Database ───────────────────────────────────────────────────────
# Path to the SQLite database file. Relative to the project root.
# The directory is created automatically on startup.
DB_PATH=data/kairo.db


# ── Logging ────────────────────────────────────────────────────────
# Controls how much output Kairo writes to the console.
# Values: DEBUG, INFO, WARNING, ERROR
# Recommended: INFO for production, DEBUG for development.
LOG_LEVEL=INFO


# ── API Server ─────────────────────────────────────────────────────
# The REST API server is used by the web dashboard to communicate with the bot.
# Start with: python src/run.py --with-api

# Host to bind the API server to.
# Use 127.0.0.1 (localhost only) unless exposing through a reverse proxy.
API_HOST=127.0.0.1

# Port the API server listens on.
API_PORT=8080

# Shared secret between the dashboard and the API.
# Must be a long, random string. Keep it secret.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET=


# ── Dashboard / OAuth2 ─────────────────────────────────────────────
# The public URL where the dashboard is accessible.
# Used to construct the OAuth2 redirect URI.
DASHBOARD_URL=http://localhost:5173

# Full OAuth2 redirect URI registered in the Discord Developer Portal.
# Defaults to DASHBOARD_URL/auth/callback.
# OAUTH_REDIRECT=http://localhost:5173/auth/callback


# ── Runtime ────────────────────────────────────────────────────────
# Set to true to enable debug mode.
# Debug mode: verbose logging, dev guild slash command sync.
# Always set to false in production.
DEBUG=false
